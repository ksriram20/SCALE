# NVIDIA NIM (active by default in config.yaml) — generous rate limits.
# Key from https://build.nvidia.com (starts with nvapi-).
NVIDIA_API_KEY=nvapi-your-key-here

# Free OpenRouter fallback — create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: shows up in OpenRouter's dashboard / rankings
OPENROUTER_APP_NAME=SCALE

# Optional alternative provider — Ollama cloud (free tier, higher rate limits).
# Only needed if you switch llm.provider to "ollama" in config/config.yaml.
# OLLAMA_API_KEY=your-ollama-key-here
